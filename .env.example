# Identity Bridge zkTLS - environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit a filled copy.
#
# PRIVACY: this file must never hold real identity data, provider credentials,
# raw proofs, or TLS transcripts. It configures deployment addresses and roles
# only. See docs/privacy-model.md.

# ---------------------------------------------------------------------
# Deployer
# ---------------------------------------------------------------------

# Signing key. Prefer a keystore (`forge script --account`) over an env var where
# possible; if you must use one here, never commit this file.
PRIVATE_KEY=

# Optional role separation. Defaults to the deployer when unset.
# Deploying every role to one address defeats the separation the contracts enforce.
ADMIN_ADDRESS=
GUARDIAN_ADDRESS=

# ---------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------

# CCIP chain selectors. The source selector is stamped into every outbound
# payload, so a wrong value makes every destination reject propagation.
SOURCE_CHAIN_SELECTOR=
DESTINATION_CHAIN_SELECTOR=
DESTINATION_CHAIN_SELECTORS=

# Chainlink CCIP router for this chain. Not the sender/receiver contracts.
CCIP_ROUTER=

# ---------------------------------------------------------------------
# Cross-chain trust (destination chains only)
# ---------------------------------------------------------------------

# The CredentialBridge address on the source chain. Messages from any other
# sender are refused, so a wrong value here means silent non-propagation.
ALLOWED_SOURCE_SENDER=

# ---------------------------------------------------------------------
# Workflows (off-chain)
# ---------------------------------------------------------------------

# Authorized submitters permitted to call CredentialBridge.
WORKFLOW_SUBMITTER=

# How often the expiry sweeper runs. Expiry itself is enforced lazily on read,
# so this only affects the event trail, not correctness.
EXPIRY_SWEEP_CRON=

# Renew window. Credentials inside this window are surfaced *before* they expire.
RENEW_WINDOW_SECONDS=604800

# Provider adapter configuration, keyed by provider id.
PROVIDER_CONFIG_URI=
PROVIDER_HEARTBEAT_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------
# Schema defaults
# ---------------------------------------------------------------------

# Applied only when a schema does not specify its own TTL.
DEFAULT_TTL_SECONDS=2592000

# Delay between scheduling and executing an unpause. Guarding may pause
# immediately; resuming is deliberately the slow direction.
UNPAUSE_DELAY_SECONDS=86400

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------

# Revocation propagation lag beyond this is an alertable incident.
REVOCATION_LAG_ALERT_SECONDS=900

# Replica age beyond which integrators are expected to deny access.
STALE_REPLICA_ALERT_SECONDS=86400

# Documented externally. Must be a URI, never inline policy text that could
# carry case data.
PRIVACY_POLICY_URI=
SCHEMA_CONFIG_URI=